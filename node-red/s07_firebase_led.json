  {
    "id": "c_s06",
    "type": "comment",
    "z": "iot_tab",
    "name": "s06 Realtime Databaseへ保存（push）",
    "info": "Firebaseの設定（鉛筆アイコン）で、YOUR-PROJECT-ID を自分のプロジェクトIDに書き換えます。\ns09でセキュリティルールを設定した後は、Auth Type を JSON Web Token（サービスアカウント）に変更します。",
    "x": 840,
    "y": 40,
    "wires": []
  },
  {
    "id": "fn_timestamp",
    "type": "function",
    "z": "iot_tab",
    "name": "add timestamp",
    "func": "// ESP32のデータには時刻がないので、受け取った時刻を追加する\nmsg.payload.timestamp = Date.now();\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 840,
    "y": 100,
    "wires": [
      [
        "fb_push"
      ]
    ]
  },
